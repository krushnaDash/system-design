    {
      "id": "Q-6CPcYEQ36rGaqA9hgLg",
      "type": "text",
      "x": 926.1111755371094,
      "y": 1583.0078125,
      "width": 861.199462890625,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b01",
      "roundness": null,
      "seed": 325713494,
      "version": 10,
      "versionNonce": 594955670,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1771314098317,
      "link": null,
      "locked": false,
      "text": "       /**\n         * When an event has been persisted successfully the new state is created by\n         * applying the event to the current state with the eventHandler. In the case of\n         * multiple persisted events, the eventHandler is called with each event in the\n         * same order as they were passed to Effect().persist(..).\n         * \n         * The event handler must only update the state and never perform side effects,\n         * as those would also be executed during recovery of the persistent actor. Side\n         * effects should be performed in thenRun from the command handler after\n         * persisting the event or from the RecoveryCompleted after Recovery.\n         * \n         */",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "       /**\n         * When an event has been persisted successfully the new state is created by\n         * applying the event to the current state with the eventHandler. In the case of\n         * multiple persisted events, the eventHandler is called with each event in the\n         * same order as they were passed to Effect().persist(..).\n         * \n         * The event handler must only update the state and never perform side effects,\n         * as those would also be executed during recovery of the persistent actor. Side\n         * effects should be performed in thenRun from the command handler after\n         * persisting the event or from the RecoveryCompleted after Recovery.\n         * \n         */",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
