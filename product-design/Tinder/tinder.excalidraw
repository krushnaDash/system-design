    {
      "id": "IKGNsjiaXNuhBXADQLRWt",
      "type": "text",
      "x": 409.25687408447266,
      "y": 2822.396484375,
      "width": 990.2194213867188,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
