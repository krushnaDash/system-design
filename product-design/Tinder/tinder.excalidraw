      "updated": 1781595204440,
      "link": null,
      "locked": false,
      "text": "FR\n->User able to create/update prefrence (profile)\n->User able view stack of match profile based current location\n->User able to swipe left or right to show intrest\n->User should get match notification once they swipe yes for each other\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FR\n->User able to create/update prefrence (profile)\n->User able view stack of match profile based current location\n->User able to swipe left or right to show intrest\n->User should get match notification once they swipe yes for each other\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
