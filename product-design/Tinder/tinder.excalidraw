      "boundElements": [],
      "updated": 1781595271257,
      "link": null,
      "locked": false,
      "text": "NFR\n->Match strong consistency over the avalibitly\n->Scale for 100K RPS\n->Less then 300Ms response for matching \n->User should get match notification once they swipe yes for each other\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NFR\n->Match strong consistency over the avalibitly\n->Scale for 100K RPS\n->Less then 300Ms response for matching \n->User should get match notification once they swipe yes for each other\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
