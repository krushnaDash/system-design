      "versionNonce": 1962193510,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1770869474247,
      "link": null,
      "locked": false,
      "text": "Redist will maintent two inverted index\none using simple list/stack for recent post\nother using a sorted set for like count sort\nwe will limit the post_ids per keyword to 1K to\n2K -> as no user might want see all the 1M post\nfor a key word. ",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Redist will maintent two inverted index\none using simple list/stack for recent post\nother using a sorted set for like count sort\nwe will limit the post_ids per keyword to 1K to 2K -> as no user might want see all the 1M post\nfor a key word. ",
      "autoResize": false,
      "lineHeight": 1.35
    },
