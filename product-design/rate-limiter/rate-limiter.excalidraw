      "index": "aV",
      "roundness": null,
      "seed": 1336979436,
      "version": 251,
      "versionNonce": 511831636,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781104579876,
      "link": null,
      "locked": false,
      "text": "Option 2, fixed token assignment \n\nUser_id -> token_left, token_assign_time\n\nis allowd =  (token_left)\n                or (currnet time - token_assign_time > 1 min)\n\nif currnet time - token_assign_time  > 1 min assign99 token again and update the \ntoken_assign_time",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Option 2, fixed token assignment \n\nUser_id -> token_left, token_assign_time\n\nis allowd =  (token_left)\n                or (currnet time - token_assign_time > 1 min)\n\nif currnet time - token_assign_time  > 1 min assign99 token again and update the \ntoken_assign_time",
      "autoResize": true,
      "lineHeight": 1.25
    }
